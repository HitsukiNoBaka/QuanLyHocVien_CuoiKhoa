@inherits LayoutComponentBase

<a class="skip-link" href="#main-content">Đến nội dung chính</a>
<div class="app-shell" @onkeydown="HandleKeyDown">
    <aside id="app-navigation" class="app-sidebar @(menuOpen ? "is-open" : "")" aria-label="Thanh điều hướng">
        <NavMenu OnNavigate="CloseMenu" OnLogout="ShowLogoutNotice" />
    </aside>

    @if (menuOpen)
    {
        <button class="menu-backdrop" type="button" @onclick="CloseMenu" aria-label="Đóng điều hướng"></button>
    }

    <div class="app-main">
        <header class="app-topbar">
            <div class="topbar-start">
                <button class="menu-toggle" type="button" @onclick="ToggleMenu" aria-controls="app-navigation" aria-expanded="@menuOpen.ToString().ToLowerInvariant()" aria-label="Mở hoặc đóng điều hướng">
                    <RadzenIcon Icon="menu" />
                </button>
                <span>Không gian làm việc</span>
            </div>
            @* Nhãn vai trò minh họa. Khi thêm Identity, thay bằng vai trò người đăng nhập. *@
            @*Hiển thị nút Đăng nhập nếu chưa đăng nhập , nếu đã đăng nhập hiện tên và vai trò*@
            <AuthorizeView Context="auth">
                <Authorized>
                    <div class="account-menu">
                        <div class="account-identity">
                            <span>@auth.User.Identity?.Name</span>

                            @if (auth.User.IsInRole("Admin"))
                            {
                                <span class="badge bg-success">Quản trị viên</span>
                            }
                            else if (auth.User.IsInRole("Staff"))
                            {
                                <span class="badge bg-primary">Cán bộ</span>
                            }
                            else if (auth.User.IsInRole("Student"))
                            {
                                <span class="badge bg-secondary">Học viên</span>
                            }
                        </div>

                        <details class="account-dropdown-host">
                            <summary class="account-avatar"
                                     aria-label="Mở menu tài khoản">
                                @GetInitials(auth.User.Identity?.Name)
                            </summary>

                            <div class="account-dropdown">
                                <form method="post"
                                      action="/Account/Logout"
                                      data-enhance="false">
                                    <AntiforgeryToken />
                                    <button type="submit">Đăng xuất</button>
                                </form>
                            </div>
                        </details>

                    </div>
                </Authorized>

                <NotAuthorized>
                    <a class="btn btn-success" href="/Login">Đăng nhập</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <main id="main-content" class="app-content" tabindex="-1">
            @if (showLogoutNotice)
            {
                <div class="demo-notice" role="status">
                    Chức năng đăng nhập và đăng xuất sẽ được bổ sung ở bước tiếp theo.
                    <button type="button" @onclick="() => showLogoutNotice = false" aria-label="Đóng thông báo">×</button>
                </div>
            }
            @Body
        </main>
        <footer class="app-footer">Học viện An ninh nhân dân · Quản lý kết quả rèn luyện</footer>
    </div>
</div>

<RadzenComponents />
<div id="blazor-error-ui" role="alert">
    Kết nối ứng dụng bị gián đoạn. <a href="" class="reload">Tải lại trang</a>
    <a class="dismiss" aria-label="Đóng">×</a>
</div>

@code {
    private bool menuOpen;
    private bool showLogoutNotice;
    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
    private void HandleKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CloseMenu(); }
    private void ShowLogoutNotice() { showLogoutNotice = true; menuOpen = false; }

    private static string GetInitials(string? userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
        {
            return "?";
        }

        return userName[..Math.Min(2, userName.Length)].ToUpperInvariant();
    }
}
